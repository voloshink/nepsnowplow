{
    "name": "neppersnowplow",
    "version": "1.0.0",
    "description": "A local Snowplow Collector and GUI to inspect collected events",
    "author": "Picnic Technologies",
    "keywords": [
        "snowplow",
        "picnic",
        "event",
        "logger",
        "inspector"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/PicnicSupermarket/nepsnowplow"
    },
    "bugs": {
        "url": "https://github.com/PicnicSupermarket/nepsnowplow/issues"
    },
    "licence": "MIT",
    "scripts": {
        "dev": "electron-vite dev",
        "build": "electron-vite build && electron-builder",
        "start": "electron-vite preview",
        "typecheck": "tsc --build",
        "postinstall": "yarn unzip",
        "format": "yarn prettier --write .",
        "format:ci": "yarn prettier --check .",
        "lint": "yarn eslint . --fix",
        "lint:ci": "yarn eslint .",
        "unzip": "(cd jre ; unzip -o -qq \\*.zip)",
        "precommit": "pretty-quick --staged",
        "test": "yarn playwright test",
        "test:ci": "xvfb-run --auto-servernum --server-args=\"-screen 0 1280x960x24\" -- yarn test"
    },
    "main": "out/main/index.mjs",
    "build": {
        "appId": "com.picnic.neppersnowplow",
        "productName": "NepperSnowplow",
        "copyright": "Copyright © 2017-2018 Picnic Technologies BV",
        "directories": {
            "output": "dist"
        },
        "dmg": {
            "writeUpdateInfo": false
        },
        "files": [
            "out/**/*",
            "server/**/*"
        ],
        "extraResources": [
            "settings.json",
            "jars/**/*",
            "snowplow_micro_config/**/*"
        ],
        "artifactName": "${name}-${version}-${os}.${ext}",
        "win": {
            "extraResources": [
                {
                    "from": "jre/win32_${arch}",
                    "to": "jre/win32_${arch}"
                }
            ],
            "target": [
                {
                    "target": "portable",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "mac": {
            "category": "public.app-category.developer-tools",
            "extraResources": [
                {
                    "from": "jre/darwin_${arch}",
                    "to": "jre/darwin_${arch}"
                }
            ],
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                }
            ]
        }
    },
    "publish": {
        "provider": "github",
        "vPrefixedTagName": true,
        "releaseType": "draft"
    },
    "devDependencies": {
        "@playwright/test": "^1.50.0",
        "@preact/preset-vite": "^2.10.5",
        "@types/body-parser": "^1.19.6",
        "@types/express": "^5.0.6",
        "@types/node": "^25.9.0",
        "electron": "^41.6.1",
        "electron-builder": "^26.0.0",
        "electron-reloader": "^1.2.3",
        "electron-vite": "^5.0.0",
        "eslint": "^8.30.0",
        "eslint-config-airbnb-base": "^15.0.0",
        "eslint-config-prettier": "^8.5.0",
        "eslint-plugin-import": "^2.26.0",
        "husky": "^4.3.0",
        "playwright": "^1.50.0",
        "prettier": "^2.1.1",
        "pretty-quick": "^3.0.0",
        "sass": "^1.26.10",
        "typescript": "^6.0.3",
        "vite": "^8.0.13"
    },
    "dependencies": {
        "@electron/remote": "^2.1.3",
        "@tanstack/react-virtual": "^3.13.24",
        "ajv": "^6.12.4",
        "axios": "^1.16.1",
        "body-parser": "^2.2.2",
        "electron-log": "^5.4.4",
        "electron-updater": "^6.6.2",
        "express": "^5.2.1",
        "handlebars": "^4.7.6",
        "jsonfile": "^6.0.1",
        "mark.js": "^8.11.1",
        "network": "^0.5.0",
        "preact": "^10.29.2",
        "renderjson": "^1.4.0",
        "zustand": "^5.0.13"
    }
}
